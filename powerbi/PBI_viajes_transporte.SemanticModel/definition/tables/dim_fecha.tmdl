		isNameInferred
		sourceColumn: [EsFinDeSemana]

		annotation SummarizationSetBy = Automatic

	partition dim_fecha = calculated
		mode: import
		source =
				
				VAR FechaMin =
				    MIN(Dim_facts[fecha_hora])
				VAR FechaMax =
				    MAX(Dim_facts[fecha_hora])
				RETURN
				    ADDCOLUMNS(
				        CALENDAR(
				            DATE(YEAR(FechaMin), MONTH(FechaMin), DAY(FechaMin)),
				            DATE(YEAR(FechaMax), MONTH(FechaMax), DAY(FechaMax))
				        ),
				        "Año", YEAR([Date]),
				        "MesNumero", MONTH([Date]),
				        "Mes", FORMAT([Date], "MMMM", "es-ES"),
				        "Trimestre", "T" & FORMAT([Date], "Q"),
				        "AñoMes", FORMAT([Date], "yyyy-MM"),
				        "Dia", DAY([Date]),
				        "DiaSemanaNumero", WEEKDAY([Date], 2),
				        "DiaSemana", FORMAT([Date], "dddd", "es-ES"),
				        "EsFinDeSemana",
				            WEEKDAY([Date], 2) >= 6
				    )

	annotation PBI_Id = 6c347c102a824773a6c49cc78dbcf25f


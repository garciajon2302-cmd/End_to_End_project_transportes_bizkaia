	column 'Hora (ubicaciones)' =
			IF(
				ISBLANK('dim_facts'[Hora]),
				BLANK(),
				(INT(('dim_facts'[Hora] * 24) / 2) * 2) / 24
			)
		dataType: dateTime
		formatString: Short Time
		lineageTag: 309b5925-6c9a-472c-86bd-be62186bce5e
		summarizeBy: none


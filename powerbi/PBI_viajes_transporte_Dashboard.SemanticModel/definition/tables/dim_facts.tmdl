	partition dim_facts = m
		mode: import
		source =
				let
				    Origen = Value.NativeQuery(PostgreSQL.Database("localhost:5432", "transportes_bizkaia"), "SELECT#(lf)    pas.*,#(lf)    CASE GREATEST(pas.zona_entrada, pas.zona_salida)#(lf)        WHEN 1 THEN tar.zona_1#(lf)        WHEN 2 THEN tar.zona_2#(lf)        WHEN 3 THEN tar.zona_3#(lf)        WHEN 4 THEN tar.zona_4#(lf)        WHEN 5 THEN tar.zona_5#(lf)    END AS precio_billete#(lf)FROM trans_viajes_bizkaia pas#(lf)JOIN tarifas_viajes tar#(lf)    ON tar.año = EXTRACT(YEAR FROM pas.fecha_hora)::integer#(lf)    AND tar.modo = pas.modo", null, [EnableFolding=true])
				in
				    Origen

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table


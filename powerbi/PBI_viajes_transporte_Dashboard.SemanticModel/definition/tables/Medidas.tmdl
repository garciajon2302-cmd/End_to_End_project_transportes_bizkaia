	measure 'Pasajeros modo más utilizado' =
			
			VAR ModoTop = [Modo más utilizado]
			RETURN
			    CALCULATE(
			        [Total pasajeros],
			        REMOVEFILTERS (dim_facts[modo]),
			        dim_facts[modo] = ModoTop
			    )
		formatString: 0
		displayFolder: Pasajeros
		lineageTag: 78934cc7-889c-4036-b2d8-29dce61919d3

	measure 'Cuota modo más utilizado' =
			
			DIVIDE(
			    [Pasajeros modo más utilizado],
			    CALCULATE(
			        [Total pasajeros],
			        REMOVEFILTERS(dim_facts[modo])
			    )
			)
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: Pasajeros
		lineageTag: a53f45b1-b742-48ff-af09-04de3260b237

	measure 'Ranking Horas' =
			
			RANKX(
			    ALLSELECTED(dim_facts[Hora]),
			    [Total pasajeros],
			    ,
			    DESC,
			    DENSE
			)
		formatString: 0
		lineageTag: b840b03d-e683-4b66-8dc9-8cca1c53162d

	measure '% Pasajeros vs Media' =
			
			VAR PasajerosHora =
			    SUM(dim_facts[pasajeros])
			
			VAR MediaDiaSemana =
			    CALCULATE(
			        AVERAGEX(
			            VALUES(dim_facts[Hora]),
			            CALCULATE(SUM(dim_facts[pasajeros]))
			        ),
			        REMOVEFILTERS(dim_facts[Hora])
			    )
			
			VAR Porcentaje =
			    DIVIDE(
			        PasajerosHora - MediaDiaSemana,
			        MediaDiaSemana
			    )
			
			RETURN
			    IF(
			        ISBLANK(Porcentaje),
			        BLANK(),
			        IF(Porcentaje >= 0, "↑ ", "↓ ")
			            & FORMAT(ABS(Porcentaje), "0.00%")
			    )
		lineageTag: 9df7d48c-a812-489c-9088-54e90bffbd5c

	measure MediaDiaSemana = ```
			
			    CALCULATE(
			        AVERAGEX(
			            VALUES(dim_facts[Hora]),
			            CALCULATE(SUM(dim_facts[pasajeros]))
			        ),
			        REMOVEFILTERS(dim_facts[Hora])
			    )
			```
		formatString: #,0
		lineageTag: 8b1a54f1-1909-4b26-8593-c5a69e9eb708

	measure 'Ranking Precio por Transporte' =
			
			VAR PrecioActual =
			    CALCULATE(
			        MAX(dim_facts[precio_billete])
			    )
			VAR TransporteActual =
			    SELECTEDVALUE(dim_facts[modo])
			VAR Trayectos =
			    CALCULATETABLE(
			        SUMMARIZE(
			            dim_facts,
			            dim_facts[zona_entrada],
			            dim_facts[zona_salida],
			            "PrecioTrayecto",
			                MAX(dim_facts[precio_billete])
			        ),
			        REMOVEFILTERS(dim_facts),
			        dim_facts[modo] = TransporteActual
			    )
			RETURN
			    RANKX(
			        Trayectos,
			        [PrecioTrayecto],
			        PrecioActual,
			        DESC,
			        DENSE
			    )
		formatString: 0
		lineageTag: 3416e4d6-d162-4af1-9faf-01230af9a4bc

	measure 'Variación ingresos Mensuales %' = ```
			
			        DIVIDE(
